{
  "name": "elliniko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lector personal de griego moderno con traducción al tocar. PWA estática, offline.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:dict": "node scripts/build-dict/index.ts",
    "sample:dict": "node scripts/build-dict/sample.ts",
    "coverage:text": "node scripts/build-dict/coverage.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "jszip": "^3.10.2",
    "preact": "^10.27.0",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
